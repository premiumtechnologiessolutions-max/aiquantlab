# Copy values into the current PowerShell process; do not put real credentials here.
AI_QUANT_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
AI_QUANT_MT5_LOGIN=
AI_QUANT_MT5_PASSWORD=
AI_QUANT_MT5_SERVER=

# Optional broker symbol suffix, for example .a or m
AI_QUANT_MT5_SYMBOL_SUFFIX=
# IOC, FOK, or RETURN according to the broker's demo symbol requirements.
AI_QUANT_MT5_FILLING_MODE=IOC

# Guarded demo orders remain off unless deliberately enabled.
AI_QUANT_ENABLE_DEMO_ORDERS=false
AI_QUANT_DEMO_MAX_VOLUME=0.10
AI_QUANT_DEMO_MAX_SPREAD_POINTS=50
